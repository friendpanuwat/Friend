{
  "format_version": "1.21.100",
  "minecraft:entity": {
    "description": {
      "identifier": "po:friend",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "po:emote": {
          "type": "int",
          "range": [0, 7],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "po:tamed": {
        "minecraft:is_tamed": {}
      },
      "po:follow": {
        "minecraft:mark_variant": { "value": 0 },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.15,
          "start_distance": 6,
          "stop_distance": 2.5
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 2 }
      },
      "po:guard": {
        "minecraft:mark_variant": { "value": 2 },
        "minecraft:behavior.follow_owner": {
          "priority": 5,
          "speed_multiplier": 1.2,
          "start_distance": 8,
          "stop_distance": 3
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 2 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": true,
          "must_reach": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "monster" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "creeper" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "enderman" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "zombie_pigman" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "piglin" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "warden" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "ghast" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "phantom" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "vex" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "guardian" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "shulker" },
                  { "test": "is_family", "subject": "other", "operator": "not", "value": "creaking" }
                ]
              },
              "max_dist": 16
            }
          ]
        }
      },
      "po:stay": {
        "minecraft:mark_variant": { "value": 1 }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["po_friend", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:movement": { "value": 0.3 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": true,
        "can_pass_doors": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:persistent": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": { "test": "is_family", "subject": "other", "value": "player" }
            },
            "deals_damage": "no"
          },
          { "cause": "fall", "deals_damage": "no" }
        ]
      },
      "minecraft:tameable": {
        "probability": 0.0,
        "tame_items": "minecraft:barrier",
        "tame_event": { "event": "po:on_tame", "target": "self" }
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": { "test": "is_family", "subject": "other", "value": "player" }
            },
            "interact_text": "action.interact.po",
            "swing": true
          }
        ]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 1,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "creeper" },
            "max_dist": 5,
            "walk_speed_multiplier": 1.2,
            "sprint_speed_multiplier": 1.4
          }
        ]
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 2,
        "entity_types": {
          "filters": {
            "all_of": [
              { "test": "is_family", "subject": "other", "operator": "not", "value": "creeper" },
              { "test": "is_family", "subject": "other", "operator": "not", "value": "player" }
            ]
          }
        }
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 3,
        "track_target": true,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8,
        "probability": 0.05
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "po:on_tame": {
        "add": { "component_groups": ["po:tamed", "po:follow"] }
      },
      "po:mode_follow": {
        "remove": { "component_groups": ["po:guard", "po:stay"] },
        "add": { "component_groups": ["po:follow"] }
      },
      "po:mode_guard": {
        "remove": { "component_groups": ["po:follow", "po:stay"] },
        "add": { "component_groups": ["po:guard"] }
      },
      "po:mode_stay": {
        "remove": { "component_groups": ["po:follow", "po:guard"] },
        "add": { "component_groups": ["po:stay"] }
      }
    }
  }
}

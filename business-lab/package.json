{
  "name": "jarua-business-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode single && node scripts/to-artifact.mjs && mkdir -p prototype && cp dist-single/index.html prototype/jarua-business-lab.html",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "node scripts/interact.mjs ."
  },
  "dependencies": {
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.6.2"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "3.11.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "5.4.19",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4",
    "playwright-core": "1.57.0"
  }
}

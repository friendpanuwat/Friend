 "captions": [
  {
   "t0": 0.56,
   "t1": 4.8,
   "text": "แล้วผม รู้สึกว่า / ตราบใดที่คุณยัง มองว่า / รายได้ ของคุณ"
  },
  {
   "t0": 4.8,
   "t1": 7.68,
   "text": "อ่ะ ช่องทาง / นั้นน่ะสิ่งที่คุณ กำลังทำ / อยู่อ่ะ มันคือ"
  },
  {
   "t0": 7.68,
   "t1": 10.96,
   "text": "รายได้เสริมนะ เอง / มันก็จะเป็น รายได้ / เสริม ต่อไป"
  },
  {
   "t0": 10.96,
   "t1": 13.6,
   "text": "เรื่อยเรื่อย มันจะ / ไม่มีทางเป็น เมน / Incom / ได้ มีแต่"
  },
  {
   "t0": 13.6,
   "t1": 16.88,
   "text": "คน พูดว่า / อยากหารายได้ เสริม / อยากหาไซส์ ทัศน"
  },
  {
   "t0": 16.88,
   "t1": 18.96,
   "text": "มิน ทาสู้ / แล้วรายได้ หลัก / Active"
  },
  {
   "t0": 18.96,
   "t1": 21.68,
   "text": "Income ผม รู้สึกว่า / ถ้าอยากให้ มันมา / เป็น active"
  },
  {
   "t0": 21.68,
   "t1": 24.48,
   "text": "Incom นะคือ / ยูต้อง มอง / มัน เป็น"
  },
  {
   "t0": 24.48,
   "t1": 27.04,
   "text": "busis หรือ / ว่าการ เฮด / ความเสี่ยงกับมัน เว้ย"
  },
  {
   "t0": 27.04,
   "t1": 29.84,
   "text": "คำว่ารายได้ เสริม / หรือว่า ไซส์ / โดยส่วนใหญ่ / นะครับ"
  },
  {
   "t0": 29.84,
   "t1": 32.88,
   "text": "ไม่มี ความเสี่ยง / ไม่มีคำว่า เจ๊ง / ไม่มีคำว่า ขาดทุนนะ"
  },
  {
   "t0": 32.88,
   "t1": 34.88,
   "text": "เพราะว่า อย่า / เอาเวลาของ You / ไป ใช้แล้วยู"
  },
  {
   "t0": 34.88,
   "t1": 37.6,
   "text": "จะ คิดใน / มุมของ Misset ที่"
  },
  {
   "t0": 37.6,
   "t1": 39.28,
   "text": "เอ่อมิ เนไม"
  },
  {
   "t0": 39.28,
   "t1": 41.68,
   "text": "ความเสี่ยงให้มาก ที่สุด / เลยทำให้ ยังไง / ก็ได้ ให้มัน"
  },
  {
   "t0": 41.68,
   "t1": 45.52,
   "text": "แบบแค่เป็น รายได้ / เสริมอ่ะ / ตอนที่ผมทำ คอนเทนต์"
  },
  {
   "t0": 45.52,
   "t1": 47.28,
   "text": "น่ะผมจะ ตอนที่ / ผมทำ คอนเทนต์แล้ว / ผมก็ ทำเป็น"
  },
  {
   "t0": 47.28,
   "t1": 49.52,
   "text": "รายได้เสริมอ่ะ ประจำ / ผมไป ใช่ป่ะ"
  },
  {
   "t0": 49.52,
   "t1": 51.79,
   "text": "เซตผมมันไม่ เหมือนกับ / อย่างงี้เลย / มันมันมี หลายอย่าง"
  },
  {
   "t0": 51.79,
   "t1": 54.4,
   "text": "ที่มัน เปลี่ยนไป / มากมาก แล้วมัน"
  },
  {
   "t0": 54.4,
   "t1": 56.64,
   "text": "ผมก็ยังเห็น Infonser / บางคนเขาก็ พูดว่า / เอออัน เนี้ย"
  },
  {
   "t0": 56.64,
   "t1": 58.72,
   "text": "เป็นช่องทาง หารายได้ / เสริมที่ดี"
  },
  {
   "t0": 58.72,
   "t1": 60.581,
   "text": "ซึ่งถ้า คุณแค่ / คิดว่ามันเป็น รายได้"
  }
 ],

{
 "captions": [
  {
   "t0": 0.48,
   "t1": 1.68,
   "text": "จะโกรธ / หมายถ้า / เราบอ กว่า"
  },
  {
   "t0": 1.68,
   "t1": 2.8,
   "text": "ยังมี บาง / คนใช้วิธี เรียน"
  },
  {
   "t0": 2.8,
   "t1": 4.48,
   "text": "ภาษาอังกฤษ ที่ยัง / ไม่ เหมาะสม / กับตัวเอง มาก"
  },
  {
   "t0": 4.48,
   "t1": 6.08,
   "text": "ที่สุดเพราะ วันนี้ / เรา จะไม่"
  },
  {
   "t0": 6.08,
   "t1": 8.8,
   "text": "แนะนำวิธี / หนึ่งที่ เรียก / ว่า / Conprentblenport"
  },
  {
   "t0": 8.8,
   "t1": 11.44,
   "text": "เพื่อ บางคน / ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 12.95,
   "text": "พูด ง่าย / มันคือ การ / หา อะไรที่"
  },
  {
   "t0": 12.95,
   "t1": 15.12,
   "text": "เรา เกือบ / เข้าใจแล้ว / อีก เดียวจะ"
  },
  {
   "t0": 15.12,
   "t1": 17.44,
   "text": "เข้าใจแล้ว / เรา ก็อยู่ / กับ มันฟัง"
  },
  {
   "t0": 17.44,
   "t1": 18.88,
   "text": "ซ้ำไป เรื่อย / เรื่อยแต่ เติม"
  },
  {
   "t0": 18.88,
   "t1": 20.88,
   "text": "อะไร ใหม่ / เข้ามาพูด / ง่าย ง่ายมัน"
  },
  {
   "t0": 20.88,
   "t1": 23.52,
   "text": "คือ การเรียน / สิ่งใหม่ จาก / บริบท เดิม"
  },
  {
   "t0": 23.52,
   "t1": 25.04,
   "text": "อย่างเช่น วันนี้ / เรา จะมา / สอน คำศัพท์"
  },
  {
   "t0": 25.04,
   "t1": 27.84,
   "text": "ใหม่เผื่อ บางคน / ไม่รู้คำ / ว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 29.04,
   "text": "เรา จะไม่ / ใช้ประโยค อังกฤษ"
  },
  {
   "t0": 29.04,
   "t1": 30.72,
   "text": "ด้วย เราจะ / ใช้ประโยค ไทย / แล้วก็ ใช้คำ"
  },
  {
   "t0": 30.72,
   "t1": 33.04,
   "text": "ว่า conskence / เข้าไป เหมือน / เวลา คนพูด"
  },
  {
   "t0": 33.04,
   "t1": 34.64,
   "text": "อังกฤษคำ ไทย / คำ เราก็"
  },
  {
   "t0": 34.64,
   "t1": 35.92,
   "text": "จะไม่ เฉลย / ความหมายด้วย"
  },
  {
   "t0": 35.92,
   "t1": 39.04,
   "text": "เพราะว่า จุดประสงค์ / ของ การเรียน / แบบ Conprensible"
  },
  {
   "t0": 39.04,
   "t1": 41.04,
   "text": "inpood คือ เรา / เรียนรู้ ความหมาย / ของมัน จาก"
  },
  {
   "t0": 41.04,
   "t1": 42.96,
   "text": "บริบท เองงั้น / มารอง ประโยค"
  },
  {
   "t0": 42.96,
   "t1": 44.32,
   "text": "แรกเลย"
  },
  {
   "t0": 44.32,
   "t1": 46.64,
   "text": "เขาโกหก ครั้ง / เดียวแต่ ต้อง / โกหก ไปอีก"
  },
  {
   "t0": 46.64,
   "t1": 48.72,
   "text": "สิบรอบ เพราะ / คอนซิ ควน / ของการ โกหก"
  },
  {
   "t0": 48.72,
   "t1": 51.44,
   "text": "คือ มันไม่ / มี วันจบ / ประโยค ที่สอง"
  },
  {
   "t0": 51.44,
   "t1": 54.96,
   "text": "ประเทศ ที่ไม่ / ลงทุนกับ การศึกษา / consicance จะ / เห็นได้ชัด"
  },
  {
   "t0": 54.96,
   "t1": 57.12,
   "text": "ในอีก ยี่สิบ / ปี ข้างหน้า"
  },
  {
   "t0": 57.12,
   "t1": 60.24,
   "text": "ประโยค ที่สาม / ทิ้ง ขยะลง / แม่น้ำ น้ำเน่า"
  },
  {
   "t0": 60.24,
   "t1": 63.12,
   "text": "ปลาตาย คนใน / ชุมชน เดือดร้อน / Conskence ของ"
  },
  {
   "t0": 63.12,
   "t1": 65.28,
   "text": "การไม่ แคร์ / สิ่งแวดล้อม ไม่ได้ / กระทบ คนแค่"
  },
  {
   "t0": 65.28,
   "t1": 66.72,
   "text": "คนเดียว"
  },
  {
   "t0": 66.72,
   "t1": 69.36,
   "text": "ประโยคที่สี่ / บริษัท นี้ไม่ / เคยฟัง เสียง"
  },
  {
   "t0": 69.36,
   "t1": 73.28,
   "text": "ของ พนักงานเลย / consiquence / คือ คนเก่ง / ทยอยกัน ลาออก"
  },
  {
   "t0": 73.28,
   "t1": 74.4,
   "text": "หมดเลย"
  },
  {
   "t0": 74.4,
   "t1": 76.37,
   "text": "ถ้า ดูแล้ว / ว่า consicnce ไป / ว่าอะไรก็ อย่า"
  }
 ],

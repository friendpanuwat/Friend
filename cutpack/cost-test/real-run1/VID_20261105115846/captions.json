{
 "captions": [
  {
   "t0": 0.48,
   "t1": 2.8,
   "text": "จะโกรธ หมายถ้า / เราบอกว่า ยังมี / บาง คนใช้วิธี / เรียน"
  },
  {
   "t0": 2.8,
   "t1": 5.9,
   "text": "ภาษาอังกฤษ ที่ยัง / ไม่ เหมาะสมกับ / ตัวเองมาก ที่สุด / เพราะวันนี้ เรา"
  },
  {
   "t0": 5.9,
   "t1": 9.84,
   "text": "จะไม่ แนะนำวิธี / หนึ่งที่ เรียกว่า / Conprentblenport / เพื่อ บางคน"
  },
  {
   "t0": 9.84,
   "t1": 11.44,
   "text": "ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 15.12,
   "text": "พูดง่ายมันคือ การ / หาอะไรที่ เรา / เกือบ เข้าใจแล้ว / อีก เดียวจะ"
  },
  {
   "t0": 15.12,
   "t1": 18.88,
   "text": "เข้าใจแล้ว เราก็ / อยู่กับมันฟัง ซ้ำไป / เรื่อย เรื่อยแต่ / เติม"
  },
  {
   "t0": 18.88,
   "t1": 22.8,
   "text": "อะไรใหม่ เข้ามา / พูดง่ายง่าย มันคือ / การเรียน สิ่งใหม่ / จาก บริบท"
  },
  {
   "t0": 22.8,
   "t1": 26.24,
   "text": "เดิม อย่างเช่น / วันนี้เรา จะมา / สอนคำศัพท์ ใหม่ / เผื่อบางคน ไม่รู้คำ"
  },
  {
   "t0": 26.24,
   "t1": 27.84,
   "text": "ว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 30.24,
   "text": "เราจะ ไม่ใช้ / ประโยค อังกฤษ / ด้วยเรา จะใช้ / ประโยค ไทย"
  },
  {
   "t0": 30.24,
   "t1": 33.04,
   "text": "แล้วก็ใช้ คำว่า / conskence / เข้าไป เหมือน / เวลา คนพูด"
  },
  {
   "t0": 33.04,
   "t1": 36.64,
   "text": "อังกฤษคำ ไทยคำ / เราก็จะไม่ เฉลย / ความหมายด้วย / เพราะว่า"
  },
  {
   "t0": 36.64,
   "t1": 39.76,
   "text": "จุดประสงค์ ของ / การเรียน แบบ / Conprensible / inpood คือ เรา"
  },
  {
   "t0": 39.76,
   "t1": 42.64,
   "text": "เรียนรู้ / ความหมาย ของ / มันจากบริบท เอง / งั้นมา รอง"
  },
  {
   "t0": 42.64,
   "t1": 44.32,
   "text": "ประโยค แรกเลย"
  },
  {
   "t0": 44.32,
   "t1": 47.68,
   "text": "เขาโกหก ครั้ง / เดียวแต่ ต้อง / โกหกไป อีกสิบ / รอบเพราะ คอนซิ"
  },
  {
   "t0": 47.68,
   "t1": 51.44,
   "text": "ควนของ การ / โกหกคือมัน ไม่มี / วันจบ ประโยค / ที่สอง"
  },
  {
   "t0": 51.44,
   "t1": 54.24,
   "text": "ประเทศ ที่ไม่ / ลงทุนกับ / การศึกษา / consicance จะ"
  },
  {
   "t0": 54.24,
   "t1": 57.12,
   "text": "เห็นได้ชัด ในอีก / ยี่สิบปี ข้างหน้า"
  },
  {
   "t0": 57.12,
   "t1": 60.8,
   "text": "ประโยค ที่สามทิ้ง / ขยะลงแม่น้ำ น้ำเน่า / ปลา ตาย"
  },
  {
   "t0": 60.8,
   "t1": 63.68,
   "text": "คนใน ชุมชน / เดือดร้อน / Conskence ของ / การไม่ แคร์"
  },
  {
   "t0": 63.68,
   "t1": 66.72,
   "text": "สิ่งแวดล้อม ไม่ได้ / กระทบ คนแค่ / คนเดียว"
  },
  {
   "t0": 66.72,
   "t1": 70.48,
   "text": "ประโยคที่สี่ บริษัท / นี้ไม่เคยฟัง เสียง / ของ พนักงานเลย"
  },
  {
   "t0": 70.48,
   "t1": 74.4,
   "text": "consiquence / คือคนเก่ง ทยอย / กันลาออก หมด / เลย"
  },
  {
   "t0": 74.4,
   "t1": 76.37,
   "text": "ถ้า ดูแล้วว่า / consicnce ไป / ว่าอะไรก็ อย่า"
  }
 ],

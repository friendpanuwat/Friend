 "subtitles": [
  {
   "t0": 0.64,
   "t1": 5.28,
   "text": "เราผลิตร้อย / ขวดก็ผลิตล้าน ขวด / ต้นทุนมันจะ เท่ากันว่า / ใครจะแพง กว่า"
  },
  {
   "t0": 5.28,
   "t1": 6.96,
   "text": "ก็ ต้อง / ของผม / แพงกว่า"
  },
  {
   "t0": 6.96,
   "t1": 10.32,
   "text": "แล้วถ้า / เกิดมัน เหมือนกัน / ทั้งสอง อย่าง / ไม่มี แบรนด์เนี่ย"
  },
  {
   "t0": 10.32,
   "t1": 12.4,
   "text": "ทำไมก็ ต้องมา / เลือก ของผม"
  },
  {
   "t0": 12.4,
   "t1": 16.32,
   "text": "เพราะฉะนั้น แบรนด์ / คืออะไร แบรนด์ / คือสัญญาต่อ ผู้บริโภค"
  },
  {
   "t0": 16.32,
   "t1": 22.72,
   "text": "ที่จำได้ ง่าย / และ มีความหมาย"
  },
  {
   "t0": 22.72,
   "t1": 27.68,
   "text": "แบรนด์ก็คือ พรมที่ / ให้กับ ลูกค้า / ที่ทั้งมีนิ่งฟู และ / Marrable"
  },
  {
   "t0": 27.68,
   "t1": 31.68,
   "text": "บางทีจำ ง่าย / อย่างที่พี่ เปย์"
  },
  {
   "t0": 31.68,
   "t1": 34.64,
   "text": "เห็นโลโก้แล้ว จำได้ / แต่ไม่มี นิ่งฟู"
  },
  {
   "t0": 34.64,
   "t1": 37.44,
   "text": "หรือว่าไม่ มีความหมาย / อะไรกันสำหรับ เขาก็ / โอเคเสีย ตังค์"
  },
  {
   "t0": 37.44,
   "t1": 40.32,
   "text": "ให้เขา เห็นไป / แต่ว่าถาม ว่ามี / แบรนด์เลิฟ เกิดไหม / มี ความผูกพัน"
  },
  {
   "t0": 40.32,
   "t1": 41.68,
   "text": "ไหม ไม่มี"
  },
  {
   "t0": 41.68,
   "t1": 42.88,
   "text": "บางอัน"
  },
  {
   "t0": 42.88,
   "t1": 46.32,
   "text": "อาจจะ มีความหมาย / แต่ชื่อจำ ไม่ได้"
  },
  {
   "t0": 46.32,
   "t1": 48.32,
   "text": "ไปเจอกัน อีกครั้ง / ก็จำไม่ได้ แบรนด์"
  },
  {
   "t0": 48.32,
   "t1": 50.8,
   "text": "ก็คือเหมือนพูดง่าย ง่าย / คือถ้า เกิดคุณ"
  },
  {
   "t0": 50.8,
   "t1": 54.24,
   "text": "หยิบสินค้า ก็มา / ใช้นิดนึงคุณ ศึกษา / มาแล้ว"
  },
  {
   "t0": 54.24,
   "t1": 56.56,
   "text": "แล้วคุณซื้อ กลับมา / คราวหน้า ผู้บริโภค"
  },
  {
   "t0": 58.9,
   "t1": 61.2,
   "text": "แล้วจาก การที่ / เขาศึกษา เค้าแล้ว / ครั้งแรก เขา"
  },
  {
   "t0": 61.2,
   "t1": 63.12,
   "text": "เห็นแล้วว่าโอ้โห นี่คือ / สิ่งที่ พรีเมียร์"
  },
  {
   "t0": 63.12,
   "t1": 64.72,
   "text": "นี่คือสิ่งที่ ดีต่อ / ครอบครัวของ เขา"
  },
  {
   "t0": 64.72,
   "t1": 65.68,
   "text": "นี่คือสิ่งที่ เฮลตี้"
  },
  {
   "t0": 65.68,
   "t1": 67.44,
   "text": "นี่คือสิ่งที่ลด การ / ต้นไม้ทำลาย ปลา"
  },
  {
   "t0": 67.44,
   "t1": 69.68,
   "text": "นี่คือสิ่งที่ ช่วยเหลือ / ชาวนาอยู่สิ่ง เหล่านี้"
  },
  {
   "t0": 69.68,
   "t1": 71.76,
   "text": "คือสิ่งที่เขา ชอบ / เพราะฉะนั้น / คราวหน้า เขา"
  },
  {
   "t0": 71.76,
   "t1": 73.36,
   "text": "ไม่ต้องมานั่ง เลือก / อีกรอบ นึงแล้ว / เขา จะใช้"
  },
  {
   "t0": 73.36,
   "t1": 74.8,
   "text": "น้ำมันชนิดไหน เขาก็ / ควรจะใช้น้ำมัน หลัง"
  },
  {
   "t0": 74.8,
   "t1": 76.0,
   "text": "ข้าวผม อย่างงี้"
  },
  {
   "t0": 76.0,
   "t1": 78.48,
   "text": "เนี่ยคือคือคำว่า แบรนด์ / ที่แท้จริงมัน ไม่ใช่"
  },
  {
   "t0": 78.48,
   "t1": 80.79,
   "text": "โลโก้อย่างที่ ทั้งสอง / ท่านได้พูด มันไม่"
  },
  {
   "t0": 80.79,
   "t1": 83.2,
   "text": "ใช่ว่าใช้สี อะไร / มันไม่ใช่ ว่าใช้"
  },
  {
   "t0": 83.2,
   "t1": 86.4,
   "text": "แพค กระจิ้ง / แบบไหน มันมัน / เป็น ส่วนนึง"
  },
  {
   "t0": 86.4,
   "t1": 89.722,
   "text": "แต่ว่ามันคือ คำสัญญา / ที่ให้ กับผู้"
  }
 ],

{
 "captions": [
  {
   "t0": 0.48,
   "t1": 2.64,
   "text": "จะโกรธ หมาย / ถ้าเราบอ กว่า / ยังมีบาง คนใช้วิธี"
  },
  {
   "t0": 2.64,
   "t1": 4.48,
   "text": "เรียน ภาษาอังกฤษ / ที่ยังไม่ เหมาะสม / กับตัวเอง มาก"
  },
  {
   "t0": 4.48,
   "t1": 7.15,
   "text": "ที่สุดเพราะ วันนี้ / เราจะไม่ แนะนำ / วิธีหนึ่งที่ เรียก"
  },
  {
   "t0": 7.15,
   "t1": 11.44,
   "text": "ว่า / Conprentblenport / เพื่อบางคน ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 13.12,
   "text": "พูด ง่ายมัน / คือ การหา / อะไรที่ เรา"
  },
  {
   "t0": 13.12,
   "t1": 16.24,
   "text": "เกือบ เข้าใจแล้ว / อีก เดียวจะ / เข้าใจแล้ว"
  },
  {
   "t0": 16.24,
   "t1": 18.08,
   "text": "เรา ก็อยู่ / กับ มันฟัง / ซ้ำไป เรื่อย"
  },
  {
   "t0": 18.08,
   "t1": 20.24,
   "text": "เรื่อยแต่ เติม / อะไรใหม่ เข้ามา"
  },
  {
   "t0": 20.24,
   "t1": 22.8,
   "text": "พูดง่าย ง่าย / มันคือ การเรียน / สิ่งใหม่จาก บริบท"
  },
  {
   "t0": 22.8,
   "t1": 25.28,
   "text": "เดิม อย่างเช่น / วันนี้เรา จะมา / สอนคำศัพท์ ใหม่"
  },
  {
   "t0": 25.28,
   "t1": 27.84,
   "text": "เผื่อบางคน ไม่รู้ / คำว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 29.68,
   "text": "เราจะ ไม่ใช้ / ประโยค อังกฤษด้วย / เรา จะใช้"
  },
  {
   "t0": 29.68,
   "t1": 32.0,
   "text": "ประโยคไทย แล้วก็ / ใช้ คำว่า / conskence เข้าไป"
  },
  {
   "t0": 32.0,
   "t1": 34.64,
   "text": "เหมือนเวลา คนพูด / อังกฤษคำ ไทย / คำ เราก็"
  },
  {
   "t0": 34.64,
   "t1": 37.36,
   "text": "จะไม่ เฉลย / ความหมายด้วย / เพราะว่า จุดประสงค์"
  },
  {
   "t0": 37.36,
   "t1": 39.76,
   "text": "ของ การเรียน / แบบ Conprensible / inpood คือ เรา"
  },
  {
   "t0": 39.76,
   "t1": 42.64,
   "text": "เรียนรู้ความหมาย ของ / มันจากบริบท เอง / งั้นมา รอง"
  },
  {
   "t0": 42.64,
   "t1": 44.32,
   "text": "ประโยค แรกเลย"
  },
  {
   "t0": 44.32,
   "t1": 46.8,
   "text": "เขาโกหก ครั้ง / เดียวแต่ ต้อง / โกหกไป อีกสิบ"
  },
  {
   "t0": 46.8,
   "t1": 49.04,
   "text": "รอบเพราะ คอนซิ / ควนของ การ / โกหก คือมัน"
  },
  {
   "t0": 49.04,
   "t1": 51.44,
   "text": "ไม่มี วันจบ / ประโยค ที่สอง"
  },
  {
   "t0": 51.44,
   "t1": 54.96,
   "text": "ประเทศ ที่ไม่ / ลงทุนกับ การศึกษา / consicance จะ / เห็นได้ชัด"
  },
  {
   "t0": 54.96,
   "t1": 57.12,
   "text": "ในอีกยี่สิบปี ข้างหน้า"
  },
  {
   "t0": 57.12,
   "t1": 60.56,
   "text": "ประโยค ที่สาม / ทิ้ง ขยะลง / แม่น้ำน้ำเน่า ปลา"
  },
  {
   "t0": 60.56,
   "t1": 63.52,
   "text": "ตายคนใน ชุมชน / เดือดร้อน Conskence / ของ การไม่"
  },
  {
   "t0": 63.52,
   "t1": 66.72,
   "text": "แคร์ สิ่งแวดล้อมไม่ / ได้ กระทบคน / แค่ คนเดียว"
  },
  {
   "t0": 66.72,
   "t1": 69.36,
   "text": "ประโยคที่สี่ / บริษัท นี้ไม่ / เคยฟัง เสียง"
  },
  {
   "t0": 69.36,
   "t1": 73.28,
   "text": "ของ พนักงานเลย / consiquence / คือ คนเก่ง / ทยอยกัน ลาออก"
  },
  {
   "t0": 73.28,
   "t1": 74.4,
   "text": "หมดเลย"
  },
  {
   "t0": 74.4,
   "t1": 76.37,
   "text": "ถ้า ดูแล้ว / ว่า consicnce ไป / ว่าอะไรก็ อย่า"
  }
 ],

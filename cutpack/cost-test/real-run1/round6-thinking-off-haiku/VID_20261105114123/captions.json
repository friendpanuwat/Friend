{
 "captions": [
  {
   "t0": 0.24,
   "t1": 3.12,
   "text": "ผมยูไซ เนสเนี่ย / มา ประมาณสี่ปี / แล้วสิ่งที่ผมกลัว ที่สุด"
  },
  {
   "t0": 3.12,
   "t1": 4.8,
   "text": "ไม่ใช่คนล้ม หนัก / ไม่สำเร็จ นะครับ"
  },
  {
   "t0": 4.8,
   "t1": 8.08,
   "text": "แต่คือคนที่คิด ว่ายิ่ง / อดได้ เยอะ / ยิ่ง เก่ง"
  },
  {
   "t0": 8.08,
   "t1": 9.76,
   "text": "คือสี่ ร้อย / แคล่วต่อวัน สำหรับ / คน ส่วนใหญ่"
  },
  {
   "t0": 9.76,
   "t1": 11.52,
   "text": "เนี่ยมันจะไม่ใช่ แผน / ล้ม หนักครับ"
  },
  {
   "t0": 11.52,
   "t1": 14.24,
   "text": "มันจะเป็น แผนที่ / ทำให้ ร่างกาย / อยู่หมด ออก"
  },
  {
   "t0": 14.24,
   "t1": 16.4,
   "text": "ตลอด นะครับ / ซึ่งน้ำหนักที่มัน หาย / ไป แน่นอน"
  },
  {
   "t0": 16.4,
   "t1": 18.48,
   "text": "ว่ามันไม่ใช่แค่ ไขมัน / อาจจะ เป็น"
  },
  {
   "t0": 18.48,
   "t1": 21.36,
   "text": "ทั้ง กล้ามเนื้อ / พลังงาน / ฮอร์โมน / สุขภาพจิต"
  },
  {
   "t0": 21.36,
   "t1": 23.04,
   "text": "แล้วก็ ความสัมพันธ์ / กับ อาหาร"
  },
  {
   "t0": 23.04,
   "t1": 26.96,
   "text": "บางคนเนี่ยจะ / เริ่มไม่มี แรง / หิวจัด นอน / ไม่ค่อยได้ อารมณ์"
  },
  {
   "t0": 26.96,
   "t1": 30.56,
   "text": "เหวี่ยงเอิ่ม หลุด / กินเยอะ หรือ / บางทีก็"
  },
  {
   "t0": 30.56,
   "t1": 32.96,
   "text": "เห็นอาหารก็ไม่ กล้ากิน / แล้วผมไม่ได้ บอกนะ"
  },
  {
   "t0": 32.96,
   "t1": 34.92,
   "text": "ว่าเคสที่กำลัง ไวรัล / อยู่เนี่ย / เกิด จาก"
  },
  {
   "t0": 34.92,
   "t1": 35.84,
   "text": "การกินน้อยอย่าง เดียว / นะครับ"
  },
  {
   "t0": 35.84,
   "t1": 38.0,
   "text": "เพราะว่า เรื่อง / สุขภาพเนี่ย มันมี / หลาย ปัจจัย"
  },
  {
   "t0": 38.0,
   "t1": 39.6,
   "text": "แต่สิ่ง ที่ผม / อยากให้ ทุกคน / เลยรู้จัก เรื่อง"
  },
  {
   "t0": 39.6,
   "t1": 41.28,
   "text": "นี้ก็คืออย่าโรแมนตี ไซส์"
  },
  {
   "t0": 41.28,
   "t1": 45.04,
   "text": "การ อดอาหาร / อย่ามอง ว่าการ / ทรมาน ตัวเอง / เนี่ยคือ วินัย"
  },
  {
   "t0": 45.04,
   "t1": 47.2,
   "text": "การลดน้ำหนักที่ดี อะครับ / ไม่ควร ทำให้"
  },
  {
   "t0": 47.2,
   "t1": 50.08,
   "text": "คุณ รู้สึกว่า / เหมือน เป็นการ / ทำโทษเลย ลงโทษ / ตัวเอง"
  },
  {
   "t0": 50.08,
   "t1": 51.84,
   "text": "บางคนจะ เป็นการ / ที่ทำให้คุณ รู้สึกว่า"
  },
  {
   "t0": 51.84,
   "t1": 53.52,
   "text": "คุณ แข็งแรงขึ้น / นะครับ"
  },
  {
   "t0": 53.52,
   "t1": 55.84,
   "text": "ใช้ชีวิต ได้ดี / ขึ้นอยู่กับ ร่างกาย / ตัวเอง"
  },
  {
   "t0": 55.84,
   "t1": 57.6,
   "text": "ได้ นานขึ้น / พร้อมเร็วเนี่ยผม บอก"
  },
  {
   "t0": 57.6,
   "t1": 58.4,
   "text": "เลยว่าไม่คุ้ม นะครับ"
  },
  {
   "t0": 58.4,
   "t1": 60.64,
   "text": "ถ้ามันต้อง แลกกับ / ร่างกาย / ที่ มันพัง"
  },
  {
   "t0": 60.64,
   "t1": 62.16,
   "text": "เป้าหมายของ การ / ฟิตเนสเนี่ย ไม่ใช่"
  },
  {
   "t0": 62.16,
   "t1": 65.44,
   "text": "การที่เรากิน น้อยที่สุด / คือการกินให้พอ ดีแล้ว"
  },
  {
   "t0": 65.44,
   "t1": 67.76,
   "text": "คุณ ทำต่อได้ / โดยที่ คุณไม่ / เกลียด อาหาร"
  },
  {
   "t0": 67.76,
   "t1": 70.48,
   "text": "แล้วก็เกลียด ตัวเอง / ถ้าคุณกำลัง ลดน้ำหนัก / อยู่นะ"
  },
  {
   "t0": 70.48,
   "t1": 72.24,
   "text": "ผมอยากให้ คุณจำ / คำนี้ไว้ เลยนะ"
  },
  {
   "t0": 72.24,
   "t1": 74.88,
   "text": "ว่าการล้น หนัก / คือการ ดูแลตัวเอง"
  },
  {
   "t0": 74.88,
   "t1": 76.48,
   "text": "ไม่ใช่การ ทำลาย / ตัวเองครับ"
  },
  {
   "t0": 76.48,
   "t1": 78.64,
   "text": "เคยผ่าน การ / อดอาหาร แบบ / สุดโต่ง / นะครับ"
  },
  {
   "t0": 78.64,
   "t1": 80.016,
   "text": "คอมเมนต์ว่า เคย / นะ ครับผม"
  }
 ],

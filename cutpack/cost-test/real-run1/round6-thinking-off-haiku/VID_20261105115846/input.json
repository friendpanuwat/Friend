 "captions": [
  {
   "t0": 0.48,
   "t1": 2.06,
   "text": "จะโกรธ หมายถ้า / เราบอ กว่า / ยังมี บาง"
  },
  {
   "t0": 2.06,
   "t1": 3.92,
   "text": "คนใช้วิธี / เรียน ภาษาอังกฤษ / ที่ยังไม่ เหมาะสม"
  },
  {
   "t0": 3.92,
   "t1": 5.28,
   "text": "กับตัวเองมาก ที่สุด"
  },
  {
   "t0": 5.28,
   "t1": 7.28,
   "text": "เพราะวันนี้ เรา / จะไม่ แนะนำ / วิธีหนึ่งที่ เรียกว่า"
  },
  {
   "t0": 7.28,
   "t1": 11.44,
   "text": "Conprentblenport / เพื่อบางคน ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 13.52,
   "text": "พูด ง่ายมัน / คือการหา อะไร / ที่เรา เกือบ"
  },
  {
   "t0": 13.52,
   "t1": 16.24,
   "text": "เข้าใจแล้ว / อีก เดียวจะ / เข้าใจแล้ว"
  },
  {
   "t0": 16.24,
   "t1": 18.4,
   "text": "เรา ก็อยู่ / กับ มันฟัง / ซ้ำไปเรื่อย เรื่อย"
  },
  {
   "t0": 18.4,
   "t1": 20.24,
   "text": "แต่เติม อะไร / ใหม่ เข้ามา"
  },
  {
   "t0": 20.24,
   "t1": 22.16,
   "text": "พูดง่ายง่าย มันคือ / การเรียน สิ่งใหม่"
  },
  {
   "t0": 22.16,
   "t1": 24.32,
   "text": "จากบริบท เดิม / อย่างเช่นวันนี้ เรา"
  },
  {
   "t0": 24.32,
   "t1": 27.84,
   "text": "จะมาสอน คำศัพท์ / ใหม่เผื่อ บางคน / ไม่รู้คำว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 29.68,
   "text": "เราจะ ไม่ใช้ / ประโยค อังกฤษ / ด้วยเรา จะใช้"
  },
  {
   "t0": 29.68,
   "t1": 32.0,
   "text": "ประโยค ไทย / แล้วก็ใช้ คำว่า / conskence เข้าไป"
  },
  {
   "t0": 32.0,
   "t1": 34.64,
   "text": "เหมือนเวลา คนพูด / อังกฤษคำ ไทย / คำ เราก็"
  },
  {
   "t0": 34.64,
   "t1": 35.92,
   "text": "จะไม่ เฉลย / ความหมายด้วย"
  },
  {
   "t0": 35.92,
   "t1": 39.6,

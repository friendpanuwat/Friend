{
 "captions": [
  {
   "t0": 0.48,
   "t1": 2.06,
   "text": "จะโกรธ หมายถ้า / เราบอ กว่า / ยังมี บาง"
  },
  {
   "t0": 2.06,
   "t1": 3.92,
   "text": "คนใช้วิธี / เรียน ภาษาอังกฤษ / ที่ยังไม่ เหมาะสม"
  },
  {
   "t0": 3.92,
   "t1": 5.28,
   "text": "กับตัวเองมาก ที่สุด"
  },
  {
   "t0": 5.28,
   "t1": 7.28,
   "text": "เพราะวันนี้ เรา / จะไม่ แนะนำ / วิธีหนึ่งที่ เรียกว่า"
  },
  {
   "t0": 7.28,
   "t1": 11.44,
   "text": "Conprentblenport / เพื่อบางคน ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 13.52,
   "text": "พูด ง่ายมัน / คือการหา อะไร / ที่เรา เกือบ"
  },
  {
   "t0": 13.52,
   "t1": 16.24,
   "text": "เข้าใจแล้ว / อีก เดียวจะ / เข้าใจแล้ว"
  },
  {
   "t0": 16.24,
   "t1": 18.4,
   "text": "เรา ก็อยู่ / กับ มันฟัง / ซ้ำไปเรื่อย เรื่อย"
  },
  {
   "t0": 18.4,
   "t1": 20.24,
   "text": "แต่เติม อะไร / ใหม่ เข้ามา"
  },
  {
   "t0": 20.24,
   "t1": 22.16,
   "text": "พูดง่ายง่าย มันคือ / การเรียน สิ่งใหม่"
  },
  {
   "t0": 22.16,
   "t1": 24.32,
   "text": "จากบริบท เดิม / อย่างเช่นวันนี้ เรา"
  },
  {
   "t0": 24.32,
   "t1": 27.84,
   "text": "จะมาสอน คำศัพท์ / ใหม่เผื่อ บางคน / ไม่รู้คำว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 29.68,
   "text": "เราจะ ไม่ใช้ / ประโยค อังกฤษ / ด้วยเรา จะใช้"
  },
  {
   "t0": 29.68,
   "t1": 32.0,
   "text": "ประโยค ไทย / แล้วก็ใช้ คำว่า / conskence เข้าไป"
  },
  {
   "t0": 32.0,
   "t1": 34.64,
   "text": "เหมือนเวลา คนพูด / อังกฤษคำ ไทย / คำ เราก็"
  },
  {
   "t0": 34.64,
   "t1": 35.92,
   "text": "จะไม่ เฉลย / ความหมายด้วย"
  },
  {
   "t0": 35.92,
   "t1": 39.6,
   "text": "เพราะว่า / จุดประสงค์ ของ / การเรียน แบบ / Conprensible / inpood คือ"
  },
  {
   "t0": 39.6,
   "t1": 42.08,
   "text": "เรา เรียนรู้ / ความหมาย ของ / มันจากบริบท เอง"
  },
  {
   "t0": 42.08,
   "t1": 44.32,
   "text": "งั้นมารอง ประโยค / แรกเลย"
  },
  {
   "t0": 44.32,
   "t1": 45.76,
   "text": "เขา โกหก / ครั้ง เดียวแต่"
  },
  {
   "t0": 45.76,
   "t1": 48.0,
   "text": "ต้อง โกหกไป / อีกสิบ รอบ / เพราะคอนซิ ควน"
  },
  {
   "t0": 48.0,
   "t1": 50.08,
   "text": "ของการ โกหก / คือมันไม่มี วันจบ"
  },
  {
   "t0": 50.08,
   "t1": 51.44,
   "text": "ประโยค ที่สอง"
  },
  {
   "t0": 51.44,
   "t1": 53.36,
   "text": "ประเทศที่ไม่ ลงทุน / กับ การศึกษา"
  },
  {
   "t0": 53.36,
   "t1": 57.12,
   "text": "consicance จะ / เห็นได้ชัด / ในอีกยี่สิบปี ข้างหน้า"
  },
  {
   "t0": 57.12,
   "t1": 60.24,
   "text": "ประโยค ที่สาม / ทิ้ง ขยะลง / แม่น้ำ น้ำเน่า"
  },
  {
   "t0": 60.24,
   "t1": 63.04,
   "text": "ปลาตายคนใน ชุมชน / เดือดร้อน Conskence"
  },
  {
   "t0": 63.04,
   "t1": 66.72,
   "text": "ของการไม่ แคร์ / สิ่งแวดล้อม / ไม่ได้ กระทบ / คนแค่ คนเดียว"
  },
  {
   "t0": 66.72,
   "t1": 70.48,
   "text": "ประโยคที่สี่ / บริษัทนี้ไม่ เคย / ฟังเสียง ของ / พนักงานเลย"
  },
  {
   "t0": 70.48,
   "t1": 74.4,
   "text": "consiquence / คือ คนเก่ง / ทยอยกัน ลาออก / หมดเลย"
  },
  {
   "t0": 74.4,
   "t1": 76.37,
   "text": "ถ้า ดูแล้ว / ว่า consicnce ไป / ว่าอะไรก็ อย่า"
  }
 ],

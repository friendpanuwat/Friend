{
 "captions": [
  {
   "t0": 0.56,
   "t1": 5.12,
   "text": "แล้ว ผมรู้สึก ว่า / ตราบใดที่ คุณยังมองว่า / รายได้ ของคุณ อ่ะ"
  },
  {
   "t0": 5.12,
   "t1": 8.0,
   "text": "ช่องทาง นั้นน่ะ / สิ่ง ที่คุณ กำลัง ทำอยู่ / อ่ะ มันคือ รายได้"
  },
  {
   "t0": 8.0,
   "t1": 10.96,
   "text": "เสริม นะเอง / มัน ก็จะเป็น รายได้ / เสริม ต่อไป"
  },
  {
   "t0": 10.96,
   "t1": 13.68,
   "text": "เรื่อยเรื่อย มันจะ / ไม่ มีทาง / เป็น เมน Incom / ได้ มีแต่ คน"
  },
  {
   "t0": 13.68,
   "t1": 16.88,
   "text": "พูดว่า อยาก / หารายได้ เสริม / อยาก หา ไซส์ / ทัศน"
  },
  {
   "t0": 16.88,
   "t1": 19.6,
   "text": "มิ น ทา สู้ / แล้ว รายได้ หลัก / Active / Income"
  },
  {
   "t0": 19.6,
   "t1": 21.68,
   "text": "ผม รู้สึก ว่า / ถ้า อยาก ให้ / มัน มาเป็น / active"
  },
  {
   "t0": 21.68,
   "t1": 24.48,
   "text": "Incom นะ คือ ยู / ต้อง มอง มัน เป็น"
  },
  {
   "t0": 24.48,
   "t1": 27.04,
   "text": "busis / หรือ ว่าการ / เฮด ความเสี่ยง / กับ มัน เว้ย"
  },
  {
   "t0": 27.04,
   "t1": 29.84,
   "text": "คำ ว่า รายได้ / เสริม หรือว่า / ไซส์ โดยส่วนใหญ่ / นะ ครับ"
  },
  {
   "t0": 29.84,
   "t1": 32.88,
   "text": "ไม่ มี ความเสี่ยง / ไม่ มี คำ ว่า เจ๊ง / ไม่ มี คำ ว่า ขาดทุน นะ"
  },
  {
   "t0": 32.88,
   "t1": 35.36,
   "text": "เพราะว่า อย่า / เอา เวลา ของ / You ไป ใช้แล้ว / ยู จะ"
  },
  {
   "t0": 35.36,
   "t1": 37.6,
   "text": "คิด ใน มุม ของ / Misset ที่"
  },
  {
   "t0": 37.6,
   "t1": 39.28,
   "text": "เอ่อ มิ / เนไม"
  },
  {
   "t0": 39.28,
   "t1": 41.52,
   "text": "ความเสี่ยง ให้ มาก / ที่สุด เลย / ทำให้ ยังไง / ก็ได้ ให้"
  },
  {
   "t0": 41.52,
   "t1": 44.0,
   "text": "มัน แบบ / แค่ เป็น รายได้ / เสริม อ่ะ"
  },
  {
   "t0": 44.0,
   "t1": 46.08,
   "text": "ตอนที่ ผม ทำ / คอนเทนต์ น่ะ / ผม จะ"
  },
  {
   "t0": 46.08,
   "t1": 47.84,
   "text": "ตอนที่ ผม ทำ คอนเทนต์ / แล้ว ผม ก็ ทำเป็น / รายได้ เสริม อ่ะ"
  },
  {
   "t0": 47.84,
   "t1": 49.52,
   "text": "ประจำ ผม ไป ใช่ ป่ะ"
  },
  {
   "t0": 49.52,
   "t1": 50.8,
   "text": "เซตผม มัน ไม่ / เหมือนกับ อย่างงี้ เลย"
  },
  {
   "t0": 50.8,
   "t1": 54.4,
   "text": "มัน มัน มี หลายอย่าง / ที่ มัน เปลี่ยนไป / มาก มาก แล้ว มัน"
  },
  {
   "t0": 54.4,
   "t1": 55.68,
   "text": "ผม ก็ ยัง เห็น / Infonser บางคน"
  },
  {
   "t0": 55.68,
   "t1": 57.2,
   "text": "เขา ก็ พูดว่า / เออ อัน เนี้ย / เป็น ช่องทาง"
  },
  {
   "t0": 57.2,
   "t1": 58.72,
   "text": "หารายได้ เสริม ที่ ดี"
  },
  {
   "t0": 58.72,
   "t1": 60.581,
   "text": "ซึ่ง ถ้า คุณ / แค่ คิด ว่า / มัน เป็น รายได้"
  }
 ],

{
 "captions": [
  {
   "t0": 0.64,
   "t1": 2.72,
   "text": "เราผลิตร้อย / ขวด ก็ / ผลิตล้าน ขวด"
  },
  {
   "t0": 2.72,
   "t1": 4.4,
   "text": "ต้นทุน มัน จะเท่ากัน / ว่า ใคร"
  },
  {
   "t0": 4.4,
   "t1": 6.96,
   "text": "จะ แพง กว่า / ก็ ต้อง ของ ผม / แพง กว่า"
  },
  {
   "t0": 6.96,
   "t1": 10.32,
   "text": "แล้ว ถ้า เกิด มัน / เหมือนกัน ทั้งสอง อย่าง / ไม่ มี แบรนด์ / เนี่ย"
  },
  {
   "t0": 10.32,
   "t1": 12.4,
   "text": "ทำไม ก็ ต้อง มา / เลือก ของ ผม"
  },
  {
   "t0": 12.4,
   "t1": 16.32,
   "text": "เพราะฉะนั้น แบรนด์ / คือ อะไร แบรนด์ / คือ สัญญา / ต่อ ผู้บริโภค"
  },
  {
   "t0": 16.32,
   "t1": 19.36,
   "text": "ที่"
  },
  {
   "t0": 19.36,
   "t1": 22.72,
   "text": "จำได้ ง่าย / และ มีความหมาย"
  },
  {
   "t0": 22.72,
   "t1": 27.68,
   "text": "แบรนด์ ก็ คือ พรม / ที่ ให้ กับ ลูกค้า / ที่ ทั้ง มี นิ่ง / ฟู และ Marrable"
  },
  {
   "t0": 27.68,
   "t1": 31.68,
   "text": "บางที จำ ง่าย / อย่าง ที่ พี่ เปย์"
  },
  {
   "t0": 31.68,
   "t1": 33.52,
   "text": "เห็น โลโก้ แล้ว จำได้"
  },
  {
   "t0": 33.52,
   "t1": 35.84,
   "text": "แต่ ไม่ มี นิ่ง ฟู / หรือว่า ไม่ มีความหมาย / อะไร กัน"
  },
  {
   "t0": 35.84,
   "t1": 38.0,
   "text": "สำหรับ เขา ก็ โอเค / เสีย ตังค์ ให้ เขา / เห็น ไป"
  },
  {
   "t0": 38.0,
   "t1": 40.32,
   "text": "แต่ว่า ถาม ว่า / มี แบรนด์ / เลิฟ เกิด ไหม / มี ความผูกพัน"
  },
  {
   "t0": 40.32,
   "t1": 41.68,
   "text": "ไหม ไม่ มี"
  },
  {
   "t0": 41.68,
   "t1": 44.0,
   "text": "บาง อัน / อาจจะ มีความหมาย"
  },
  {
   "t0": 44.0,
   "t1": 46.32,
   "text": "แต่ ชื่อ จำ ไม่ ได้"
  },
  {
   "t0": 46.32,
   "t1": 47.68,
   "text": "ไป เจอกัน / อีกครั้ง ก็ จำ ไม่ ได้"
  },
  {
   "t0": 47.68,
   "t1": 50.8,
   "text": "แบรนด์ ก็ คือ เหมือน / พูด ง่าย ง่าย คือ / ถ้า เกิด คุณ"
  },
  {
   "t0": 50.8,
   "t1": 54.24,
   "text": "หยิบ สินค้า / ก็ มา ใช้ นิดนึง / คุณ ศึกษา มา แล้ว"
  },
  {
   "t0": 54.24,
   "t1": 56.0,
   "text": "แล้ว คุณ ซื้อ / กลับมา คราวหน้า"
  },
  {
   "t0": 56.0,
   "t1": 58.16,
   "text": "ผู้บริโภค ไม่ ไม่ / ควร ที่จะ ต้อง ศึกษา / อีกต่อไป"
  },
  {
   "t0": 58.16,
   "t1": 59.44,
   "text": "แล้ว เพราะ เขา / เชื่อ ไป แล้ว"
  },
  {
   "t0": 59.44,
   "t1": 61.12,
   "text": "จาก การ ที่ / เขา ศึกษา / เค้า แล้ว ครั้งแรก"
  },
  {
   "t0": 61.12,
   "t1": 62.32,
   "text": "เขา เห็น แล้ว / ว่า โอ้โห นี่ คือ"
  },
  {
   "t0": 62.32,
   "t1": 63.92,
   "text": "สิ่ง ที่ พรีเมียร์ / นี่ คือ สิ่ง ที่ ดี"
  },
  {
   "t0": 63.92,
   "t1": 64.96,
   "text": "ต่อ ครอบครัว / ของ เขา นี่ คือ"
  },
  {
   "t0": 64.96,
   "t1": 66.4,
   "text": "สิ่ง ที่ เฮลตี้ / นี่ คือ สิ่ง ที่ ลด"
  },
  {
   "t0": 66.4,
   "t1": 67.82,
   "text": "การ ต้นไม้ ทำลาย / ปลา นี่ คือ สิ่ง"
  },
  {
   "t0": 67.82,
   "t1": 69.36,
   "text": "ที่ ช่วยเหลือ / ชาวนา อยู่ สิ่ง"
  },
  {
   "t0": 69.36,
   "t1": 70.96,
   "text": "เหล่านี้ คือ สิ่ง ที่ / เขา ชอบ เพราะฉะนั้น"
  },
  {
   "t0": 70.96,
   "t1": 72.88,
   "text": "คราวหน้า เขา ไม่ต้อง / มา นั่ง เลือก / อี กรอบ นึง"
  },
  {
   "t0": 72.88,
   "t1": 74.32,
   "text": "แล้ว เขา จะ ใช้ / น้ำมัน ชนิด ไหน / เขา ก็ ควรจะ"
  },
  {
   "t0": 74.32,
   "t1": 76.0,
   "text": "ใช้ น้ำมัน / หลัง ข้าว ผม / อย่างงี้"
  },
  {
   "t0": 76.0,
   "t1": 78.16,
   "text": "เนี่ย คือ คือ / คำ ว่า / แบรนด์ ที่ แท้จริง"
  },
  {
   "t0": 78.16,
   "t1": 79.68,
   "text": "มัน ไม่ ใช่ โลโก้ / อย่าง ที่ ทั้งสอง"
  },
  {
   "t0": 79.68,
   "t1": 81.36,
   "text": "ท่าน ได้ พูด / มัน ไม่ ใช่ / ว่า ใช้"
  },
  {
   "t0": 81.36,
   "t1": 83.2,
   "text": "สี อะไร / มัน ไม่ ใช่ / ว่า ใช้"
  },
  {
   "t0": 83.2,
   "t1": 85.36,
   "text": "แพ ค กระ / จิ้ง แบบ ไหน / มัน มัน เป็น"
  },
  {
   "t0": 85.36,
   "t1": 87.84,
   "text": "ส่วน นึง / แต่ว่า มัน คือ"
  },
  {
   "t0": 87.84,
   "t1": 89.722,
   "text": "คำสัญญา ที่ / ให้ กับ ผู้"
  }
 ],

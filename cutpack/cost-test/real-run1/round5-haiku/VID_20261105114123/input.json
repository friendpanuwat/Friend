 "captions": [
  {
   "t0": 0.24,
   "t1": 1.44,
   "text": "ผมยู / ไซ เนส / เนี่ยมา"
  },
  {
   "t0": 1.44,
   "t1": 2.88,
   "text": "ประมาณสี่ปี / แล้ว สิ่งที่ / ผม กลัว"
  },
  {
   "t0": 2.88,
   "t1": 4.24,
   "text": "ที่สุดไม่ / ใช่ คนล้ม / หนักไม่ สำเร็จ"
  },
  {
   "t0": 4.24,
   "t1": 5.51,
   "text": "นะครับ / แต่คือ / คน ที่คิด"
  },
  {
   "t0": 5.51,
   "t1": 8.08,
   "text": "ว่ายิ่ง / อดได้ / เยอะยิ่ง เก่ง"
  },
  {
   "t0": 8.08,
   "t1": 9.44,
   "text": "คือสี่ ร้อย / แค ล่วต่อ / วัน สำหรับคน"
  },
  {
   "t0": 9.44,
   "t1": 11.04,
   "text": "ส่วนใหญ่เนี่ย / มันจะ ไม่ใช่ / แผนล้ม หนัก"
  },
  {
   "t0": 11.04,
   "t1": 13.2,
   "text": "ครับ / มันจะ เป็น / แผนที่"
  },
  {
   "t0": 13.2,
   "t1": 14.64,
   "text": "ทำให้ ร่างกาย / อยู่ หมด / ออก ตลอดนะ"
  },
  {
   "t0": 14.64,
   "t1": 16.4,
   "text": "ครับซึ่ง น้ำหนัก / ที่มัน หาย / ไป แน่นอน"
  },
  {
   "t0": 16.4,
   "t1": 18.08,
   "text": "ว่า มันไม่ / ใช่แค่ ไขมัน"
  },
  {
   "t0": 18.08,
   "t1": 20.0,
   "text": "อาจจะ เป็น / ทั้ง กล้ามเนื้อ / พลังงาน"
  },
  {
   "t0": 20.0,
   "t1": 22.16,
   "text": "ฮอร์โมน / สุขภาพจิต / แล้วก็ ความสัมพันธ์"
  },
  {
   "t0": 22.16,
   "t1": 24.56,
   "text": "กับ อาหาร / บางคน เนี่ยจะ / เริ่มไม่มี แรง"
  },
  {
   "t0": 24.56,
   "t1": 27.76,
   "text": "หิวจัด นอน / ไม่ค่อยได้ อารมณ์ / เหวี่ยง"
  },
  {
   "t0": 27.76,
   "t1": 30.56,
   "text": "เอิ่ม หลุด / กิน เยอะ / หรือ บางทีก็"
  },
  {
   "t0": 30.56,
   "t1": 32.72,
   "text": "เห็นอาหาร ก็ไม่ / กล้า กินแล้ว / ผม ไม่ได้"
  },
  {
   "t0": 32.72,
   "t1": 34.64,
   "text": "บอก นะว่า / เคสที่ กำลัง / ไวรัล อยู่เนี่ย"
  },
  {
   "t0": 34.64,
   "t1": 35.84,
   "text": "เกิดจาก การ / กิน น้อย / อย่างเดียว นะครับ"
  },
  {
   "t0": 35.84,
   "t1": 38.0,
   "text": "เพราะว่า เรื่อง / สุขภาพเนี่ย มันมี / หลาย ปัจจัย"
  },
  {
   "t0": 38.0,
   "t1": 39.12,
   "text": "แต่ สิ่งที่ / ผม อยากให้ / ทุกคนเลย"
  },
  {
   "t0": 39.12,
   "t1": 41.28,
   "text": "รู้จัก เรื่องนี้ก็ / คือ อย่า / โรแมนตี ไซส์"
  },
  {
   "t0": 41.28,
   "t1": 44.16,
   "text": "การ อดอาหาร / อย่ามอง ว่าการ / ทรมาน ตัวเองเนี่ย"
  },
  {
   "t0": 44.16,
   "t1": 46.4,
   "text": "คือ วินัย / การลดน้ำหนัก / ที่ดี อะครับ"
  },
  {
   "t0": 46.4,
   "t1": 48.08,
   "text": "ไม่ ควร / ทำให้คุณ / รู้สึกว่า"
  },
  {
   "t0": 48.08,
   "t1": 50.08,
   "text": "เหมือน เป็นการ / ทำโทษเลย / ลงโทษ ตัวเอง"
  },
  {
   "t0": 50.08,
   "t1": 51.84,
   "text": "บางคนจะ เป็นการ / ที่ ทำให้ / คุณ รู้สึกว่า"
  },
  {
   "t0": 51.84,
   "t1": 54.32,
   "text": "คุณ แข็งแรง / ขึ้น นะครับ / ใช้ชีวิต ได้ดี"
  },
  {
   "t0": 54.32,
   "t1": 56.96,
   "text": "ขึ้นอยู่กับ ร่างกาย / ตัวเองได้ นาน / ขึ้น พร้อม"
  },
  {
   "t0": 56.96,
   "t1": 58.4,
   "text": "เร็วเนี่ย / ผม บอกเลย / ว่าไม่คุ้ม นะครับ"
  },
  {
   "t0": 58.4,
   "t1": 59.64,
   "text": "ถ้ามัน / ต้อง แลกกับ / ร่างกายที่"
  },
  {
   "t0": 59.64,
   "t1": 60.64,
   "text": "มันพัง"
  },
  {
   "t0": 60.64,
   "t1": 62.56,
   "text": "เป้าหมาย ของการ / ฟิตเนสเนี่ย / ไม่ใช่ การ"
  },
  {
   "t0": 62.56,
   "t1": 64.48,
   "text": "ที่ เรา / กิน น้อยที่สุด / คือ การ"
  },
  {
   "t0": 64.48,
   "t1": 66.24,
   "text": "กิน ให้พอ / ดีแล้วคุณ / ทำต่อได้"
  },
  {
   "t0": 66.24,
   "t1": 68.24,
   "text": "โดยที่ คุณไม่ / เกลียด อาหาร / แล้วก็ เกลียด"
  },
  {
   "t0": 68.24,
   "t1": 70.48,
   "text": "ตัวเองถ้า / คุณกำลัง ลดน้ำหนัก / อยู่นะ"
  },
  {
   "t0": 70.48,
   "t1": 72.24,
   "text": "ผม อยาก / ให้คุณ จำคำนี้ / ไว้ เลยนะ"
  },
  {
   "t0": 72.24,
   "t1": 74.88,
   "text": "ว่า การ / ล้น หนัก / คือ การ / ดูแลตัวเอง"
  },
  {
   "t0": 74.88,
   "t1": 76.48,
   "text": "ไม่ใช่ / การทำลาย ตัวเองครับ"
  },
  {
   "t0": 76.48,
   "t1": 78.64,
   "text": "เคยผ่าน การ / อดอาหาร / แบบสุดโต่ง นะครับ"
  },
  {
   "t0": 78.64,
   "t1": 80.016,
   "text": "คอมเมนต์ว่า เคยนะ / ครับผม"
  }
 ],

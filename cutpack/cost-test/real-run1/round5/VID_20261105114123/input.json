   "t0": 14.8,
   "t1": 18.08,
   "text": "ซึ่งน้ำหนักที่มัน หาย / ไป แน่นอน / ว่ามันไม่ใช่แค่ ไขมัน"
  },
  {
   "t0": 18.08,
   "t1": 22.16,
   "text": "อาจจะ เป็นทั้ง / กล้ามเนื้อ / พลังงาน ฮอร์โมน / สุขภาพจิต แล้วก็ / ความสัมพันธ์"
  },
  {
   "t0": 22.16,
   "t1": 25.44,
   "text": "กับอาหาร บางคนเนี่ย / จะเริ่มไม่มีแรง หิวจัด"
  },
  {
   "t0": 25.44,
   "t1": 29.44,
   "text": "นอนไม่ค่อยได้ อารมณ์ / เหวี่ยงเอิ่ม หลุด / กิน เยอะ"
  },
  {
   "t0": 29.44,
   "t1": 32.96,
   "text": "หรือบางทีก็เห็น อาหาร / ก็ไม่ กล้ากิน / แล้วผมไม่ได้ บอกนะ"
  },
  {
   "t0": 32.96,
   "t1": 34.92,
   "text": "ว่าเคสที่กำลัง ไวรัล / อยู่เนี่ยเกิด จาก"
  },
  {
   "t0": 34.92,
   "t1": 35.84,
   "text": "การกินน้อย อย่าง / เดียวนะครับ"
  },
  {
   "t0": 35.84,
   "t1": 38.64,
   "text": "เพราะว่า เรื่อง / สุขภาพเนี่ย มันมี / หลาย ปัจจัย / แต่สิ่ง ที่ผม"
  },
  {
   "t0": 38.64,
   "t1": 41.28,
   "text": "อยากให้ ทุกคนเลย / รู้จักเรื่องนี้ ก็คือ / อย่าโรแมนตี ไซส์"
  },
  {
   "t0": 41.28,
   "t1": 45.76,
   "text": "การอดอาหารอย่า มอง / ว่าการ ทรมาน / ตัวเองเนี่ยคือ / วินัย การลดน้ำหนัก"
  },
  {
   "t0": 45.76,
   "t1": 47.52,
   "text": "ที่ดี อะครับ / ไม่ควร ทำให้คุณ"
  },
  {
   "t0": 47.52,
   "t1": 50.72,
   "text": "รู้สึกว่าเหมือน เป็นการ / ทำโทษเลย ลงโทษ / ตัวเอง / บางคนจะ เป็นการ"
  },
  {
   "t0": 50.72,
   "t1": 53.52,
   "text": "ที่ทำให้คุณรู้สึก ว่าคุณ / แข็งแรงขึ้น นะครับ"
  },
  {
   "t0": 53.52,
   "t1": 57.12,
   "text": "ใช้ชีวิต ได้ดี / ขึ้นอยู่กับ ร่างกาย / ตัวเอง / ได้นานขึ้นพร้อม เร็ว"
  },
  {
   "t0": 57.12,
   "t1": 58.4,
   "text": "เนี่ยผม บอกเลย / ว่าไม่ คุ้มนะครับ"
  },
  {
   "t0": 58.4,
   "t1": 60.64,
   "text": "ถ้ามันต้อง แลกกับ / ร่างกายที่ มันพัง"
  },
  {
   "t0": 60.64,
   "t1": 64.0,
   "text": "เป้าหมาย ของ / การ ฟิตเนสเนี่ย / ไม่ใช่ / การที่เรากิน น้อยที่สุด"
  },
  {
   "t0": 64.0,
   "t1": 66.8,
   "text": "คือการกินให้พอ ดีแล้ว / คุณทำต่อได้ โดยที่"
  },
  {
   "t0": 66.8,
   "t1": 68.8,
   "text": "คุณไม่ เกลียด / อาหาร แล้วก็ / เกลียด ตัวเอง"
  },
  {
   "t0": 68.8,
   "t1": 71.28,
   "text": "ถ้าคุณ กำลัง / ลดน้ำหนัก อยู่นะ / ผมอยาก ให้คุณ"
  },
  {
   "t0": 71.28,
   "t1": 72.64,
   "text": "จำคำนี้ไว้เลย นะว่า"
  },
  {
   "t0": 72.64,
   "t1": 74.88,
   "text": "การล้น หนักคือ / การ ดูแลตัวเอง"
  },
  {
   "t0": 74.88,
   "t1": 76.48,
   "text": "ไม่ใช่การ ทำลาย / ตัวเองครับ"
  },
  {
   "t0": 76.48,
   "t1": 78.32,
   "text": "เคยผ่าน การ / อดอาหาร แบบ / สุดโต่ง"
  },
  {
   "t0": 78.32,
   "t1": 80.016,
   "text": "นะครับ คอมเมนต์ / ว่าเคยนะ ครับผม"
  }
 ],

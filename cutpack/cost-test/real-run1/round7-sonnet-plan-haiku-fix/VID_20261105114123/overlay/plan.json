 "subtitles": [
  {
   "t0": 0.24,
   "t1": 2.08,
   "text": "ผมยู / ไซ เนสเนี่ย / มา ประมาณสี่ปี"
  },
  {
   "t0": 2.08,
   "t1": 3.52,
   "text": "แล้วสิ่งที่ผม กลัว / ที่สุดไม่ ใช่คน"
  },
  {
   "t0": 3.52,
   "t1": 4.8,
   "text": "ล้มหนักไม่สำเร็จ นะครับ"
  },
  {
   "t0": 4.8,
   "t1": 8.08,
   "text": "แต่คือคนที่ คิดว่า / ยิ่งอดได้ เยอะ / ยิ่ง เก่ง"
  },
  {
   "t0": 8.08,
   "t1": 9.92,
   "text": "คือสี่ร้อยแค ล่วต่อ / วัน สำหรับคน / ส่วนใหญ่เนี่ย"
  },
  {
   "t0": 9.92,
   "t1": 11.52,
   "text": "มันจะไม่ใช่ แผน / ล้ม หนักครับ"
  },
  {
   "t0": 11.52,
   "t1": 14.8,
   "text": "มันจะเป็น แผนที่ / ทำให้ ร่างกายอยู่ / หมดออก ตลอดนะ / ครับ"
  },
  {
   "t0": 14.8,
   "t1": 18.08,
   "text": "ซึ่งน้ำหนักที่มัน หายไป / แน่นอนว่า มันไม่ / ใช่แค่ ไขมัน"
  },
  {
   "t0": 18.08,
   "t1": 21.36,
   "text": "อาจจะ เป็นทั้ง / กล้ามเนื้อ / พลังงาน ฮอร์โมน / สุขภาพจิต"
  },
  {
   "t0": 21.36,
   "t1": 25.44,
   "text": "แล้วก็ ความสัมพันธ์ / กับ อาหาร / บางคนเนี่ยจะ / เริ่มไม่มี แรง / หิวจัด"
  },
  {
   "t0": 25.44,
   "t1": 29.44,
   "text": "นอนไม่ค่อยได้ อารมณ์ / เหวี่ยงเอิ่ม หลุด / กิน เยอะ"
  },
  {
   "t0": 29.44,
   "t1": 32.72,
   "text": "หรือบางทีก็ เห็น / อาหารก็ไม่ กล้า / กินแล้วผม ไม่ได้"
  },
  {
   "t0": 32.72,
   "t1": 34.92,
   "text": "บอกนะว่า เคสที่ / กำลัง ไวรัล / อยู่เนี่ยเกิด จาก"
  },
  {
   "t0": 34.92,
   "t1": 35.84,
   "text": "การกินน้อย อย่าง / เดียวนะครับ"
  },
  {
   "t0": 35.84,
   "t1": 38.0,
   "text": "เพราะว่า เรื่อง / สุขภาพเนี่ย มันมี / หลาย ปัจจัย"
  },
  {
   "t0": 38.0,
   "t1": 40.08,
   "text": "แต่สิ่งที่ผม อยาก / ให้ ทุกคน / เลยรู้จักเรื่องนี้ ก็คือ"
  },
  {
   "t0": 40.08,
   "t1": 43.92,
   "text": "อย่าโรแมนตี ไซส์ / การ อดอาหาร / อย่ามอง ว่าการ / ทรมาน ตัวเอง"
  },
  {
   "t0": 43.92,
   "t1": 46.4,
   "text": "เนี่ยคือ วินัย / การลดน้ำหนัก / ที่ดี อะครับ"
  },
  {
   "t0": 46.4,
   "t1": 50.08,
   "text": "ไม่ควรทำให้คุณ รู้สึกว่า / เหมือน เป็นการ / ทำโทษเลย ลงโทษ / ตัวเอง"
  },
  {
   "t0": 50.08,
   "t1": 51.84,
   "text": "บางคนจะ / เป็นการที่ ทำให้คุณ / รู้สึกว่า"
  },
  {
   "t0": 51.84,
   "t1": 53.52,
   "text": "คุณแข็งแรงขึ้น นะครับ"
  },
  {
   "t0": 53.52,
   "t1": 55.84,
   "text": "ใช้ชีวิต ได้ดี / ขึ้นอยู่กับ ร่างกาย / ตัวเอง"
  },
  {
   "t0": 55.84,
   "t1": 57.28,
   "text": "ได้นานขึ้น พร้อม / เร็วเนี่ย"
  },
  {
   "t0": 57.28,
   "t1": 58.4,
   "text": "ผม บอกเลยว่าไม่ / คุ้มนะครับ"
  },
  {
   "t0": 58.4,
   "t1": 60.64,
   "text": "ถ้ามันต้อง แลกกับ / ร่างกายที่ มันพัง"
  },
  {
   "t0": 60.64,
   "t1": 64.0,
   "text": "เป้าหมาย ของ / การ ฟิตเนสเนี่ย / ไม่ใช่การที่ เรา / กิน น้อยที่สุด"
  },
  {
   "t0": 64.0,
   "t1": 66.8,
   "text": "คือการกินให้พอ ดีแล้ว / คุณทำต่อได้ โดยที่"
  },
  {
   "t0": 66.8,
   "t1": 68.8,
   "text": "คุณไม่ เกลียด / อาหาร แล้วก็ / เกลียด ตัวเอง"
  },
  {
   "t0": 68.8,
   "t1": 70.48,
   "text": "ถ้าคุณ กำลัง / ลดน้ำหนัก อยู่นะ"
  },
  {
   "t0": 70.48,
   "t1": 72.1,
   "text": "ผมอยากให้ คุณจำคำ / นี้ ไว้เลย"
  },
  {
   "t0": 72.1,
   "t1": 74.88,
   "text": "นะว่าการล้น หนัก / คือการ ดูแลตัวเอง"
  },
  {
   "t0": 74.88,
   "t1": 76.48,
   "text": "ไม่ใช่การ ทำลาย / ตัวเองครับ"
  },
  {
   "t0": 76.48,
   "t1": 78.32,
   "text": "เคยผ่าน การ / อดอาหาร แบบ / สุดโต่ง"
  },
  {
   "t0": 78.32,
   "t1": 79.12,
   "text": "นะครับ คอมเมนต์"
  },
  {
   "t0": 79.12,
   "t1": 80.016,
   "text": "ว่าเคยนะ ครับผม"
  }
 ],

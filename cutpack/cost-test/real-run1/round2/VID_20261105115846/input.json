 "captions": [
  {
   "t0": 0.48,
   "t1": 1.68,
   "text": "จะโกรธ / หมาย ถ้า / เรา บอ กว่า"
  },
  {
   "t0": 1.68,
   "t1": 3.28,
   "text": "ยังมี บาง / คนใช้ วิธี / เรียน ภาษาอังกฤษ"
  },
  {
   "t0": 3.28,
   "t1": 5.28,
   "text": "ที่ ยัง ไม่ เหมาะสม / กับ ตัวเอง มาก ที่สุด"
  },
  {
   "t0": 5.28,
   "t1": 7.28,
   "text": "เพราะ วันนี้ / เรา จะ ไม่ แนะนำ / วิธี หนึ่ง ที่ เรียก ว่า"
  },
  {
   "t0": 7.28,
   "t1": 11.44,
   "text": "Conprentblenport / เพื่อ บางคน / ใช้แล้ว"
  },
  {
   "t0": 11.44,
   "t1": 13.12,
   "text": "พูด ง่าย / มัน คือ การ หา / อะไร ที่ เรา"
  },
  {
   "t0": 13.12,
   "t1": 15.52,
   "text": "เกือบ เข้าใจ / แล้ว อีก เดียว / จะ เข้าใจ"
  },
  {
   "t0": 15.52,
   "t1": 18.08,
   "text": "แล้ว เรา ก็ อยู่ / กับ มัน / ฟัง ซ้ำ ไป เรื่อย"
  },
  {
   "t0": 18.08,
   "t1": 20.24,
   "text": "เรื่อย แต่ / เติม อะไร ใหม่ / เข้ามา"
  },
  {
   "t0": 20.24,
   "t1": 22.16,
   "text": "พูด ง่าย / ง่าย มัน คือ การเรียน / สิ่งใหม่"
  },
  {
   "t0": 22.16,
   "t1": 25.04,
   "text": "จาก บริบท เดิม / อย่างเช่น / วันนี้ เรา จะ มา สอน คำศัพท์"
  },
  {
   "t0": 25.04,
   "t1": 27.84,
   "text": "ใหม่ เผื่อ บางคน / ไม่ รู้ คำ ว่า Consic"
  },
  {
   "t0": 27.84,
   "t1": 30.48,
   "text": "เรา จะ ไม่ ใช้ ประโยค / อังกฤษ ด้วย เรา จะ ใช้ / ประโยค ไทย แล้วก็"
  },
  {
   "t0": 30.48,
   "t1": 33.04,
   "text": "ใช้ คำ ว่า / conskence เข้าไป / เหมือน เวลา คนพูด"
  },
  {
   "t0": 33.04,
   "t1": 35.2,
   "text": "อังกฤษ คำ ไทย คำ / เรา ก็ จะ ไม่ เฉลย"
  },
  {
   "t0": 35.2,
   "t1": 38.24,
   "text": "ความหมาย ด้วย / เพราะว่า จุดประสงค์ / ของ การเรียน แบบ"
  },
  {
   "t0": 38.24,
   "t1": 40.64,
   "text": "Conprensible / inpood คือ เรา / เรียนรู้ ความหมาย ของ"
  },
  {
   "t0": 40.64,
   "t1": 44.32,
   "text": "มัน จาก บริบท เอง / งั้น มา รอง / ประโยค แรก เลย"
  },
  {
   "t0": 44.32,
   "t1": 46.4,
   "text": "เขา โกหก / ครั้ง เดียว แต่ / ต้อง โกหก"
  },
  {
   "t0": 46.4,
   "t1": 48.0,
   "text": "ไป อีก สิบ รอบ / เพราะ คอน ซิ ควน"
  },
  {
   "t0": 48.0,
   "t1": 50.08,
   "text": "ของ การ โกหก / คือ มัน ไม่ มี วัน จบ"
  },
  {
   "t0": 50.08,
   "t1": 52.08,
   "text": "ประโยค ที่สอง / ประเทศ ที่ ไม่"
  },
  {
   "t0": 52.08,
   "t1": 54.96,
   "text": "ลงทุน กับ การศึกษา / consicance จะ เห็นได้ชัด"
  },
  {
   "t0": 54.96,
   "t1": 57.12,
   "text": "ใน อีก ยี่สิบ ปี ข้างหน้า"
  },
  {
   "t0": 57.12,
   "t1": 60.24,
   "text": "ประโยค ที่สาม / ทิ้ง ขยะ ลง / แม่น้ำ น้ำเน่า"
  },
  {
   "t0": 60.24,
   "t1": 63.12,
   "text": "ปลา ตาย คนใน / ชุมชน เดือดร้อน / Conskence ของ"
  },
  {
   "t0": 63.12,
   "t1": 66.72,
   "text": "การ ไม่ แคร์ สิ่งแวดล้อม / ไม่ ได้ กระทบ / คน แค่ คนเดียว"
  },
  {
   "t0": 66.72,
   "t1": 70.16,
   "text": "ประโยค ที่สี่ / บริษัท นี้ ไม่ เคย / ฟัง เสียง ของ พนักงาน"
  },
  {
   "t0": 70.16,
   "t1": 74.4,
   "text": "เลย consiquence / คือ คนเก่ง ทยอย / กัน ลาออก หมด เลย"
  },
  {
   "t0": 74.4,
   "t1": 76.37,
   "text": "ถ้า ดู แล้ว / ว่า consicnce ไป ว่า / อะไร ก็ อย่า"
  }
 ],
